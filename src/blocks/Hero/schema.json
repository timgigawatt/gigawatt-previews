{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-block": "Hero",
  "x-version": 1,
  "x-description": "Top-of-page banner: headline, supporting line, one or two calls to action, optional background image. Always the first block on a page.",
  "type": "object",
  "required": ["block", "heading"],
  "additionalProperties": false,
  "properties": {
    "block": { "const": "Hero" },
    "variant": { "type": "string", "enum": ["centered", "split"], "default": "centered", "description": "centered = text over image; split = text left, image right" },
    "eyebrow": { "type": "string", "maxLength": 60, "description": "Small line above the heading, e.g. the service area" },
    "heading": { "type": "string", "maxLength": 90 },
    "subheading": { "type": "string", "maxLength": 200 },
    "primaryCta": { "$ref": "#/$defs/cta" },
    "secondaryCta": { "$ref": "#/$defs/cta" },
    "image": { "$ref": "#/$defs/image" }
  },
  "$defs": {
    "cta": {
      "type": "object", "required": ["label", "href"], "additionalProperties": false,
      "properties": { "label": { "type": "string", "maxLength": 40 }, "href": { "type": "string" } }
    },
    "image": {
      "type": "object", "required": ["src", "alt"], "additionalProperties": false,
      "properties": {
        "src": { "type": "string", "description": "Filename in src/assets/media/" },
        "alt": { "type": "string", "maxLength": 160 }
      }
    }
  }
}
