---
const { heading, text, lead } = Astro.props;
const phone = lead?.settings?.phone;
const phoneHref = phone ? `tel:${String(phone).replace(/[^\d+]/g, '')}` : null;
const cta = lead?.nav?.cta;
---
<section id="contact" class="cta-band">
  <div class="cta-band__inner">
    <div class="cta-band__text">
      <h2>{heading}</h2>
      {text && <p>{text}</p>}
    </div>
    <div class="cta-band__actions">
      {phoneHref && <a class="btn btn--inverse" href={phoneHref}>{phone}</a>}
      {cta && <a class="btn btn--ghost" href={cta.href}>{cta.label}</a>}
    </div>
  </div>
</section>
<style>
  .cta-band { padding: var(--gw-section-y) var(--gw-gutter); background: var(--gw-color-primary); color: var(--gw-color-on-primary); }
  .cta-band__inner { max-width: var(--gw-max); margin: 0 auto; display: flex; flex-wrap: wrap; gap: var(--gw-space-6); align-items: center; justify-content: space-between; }
  .cta-band__text { flex: 1 1 320px; }
  h2 { font-size: var(--gw-h1); margin-bottom: var(--gw-space-3); }
  p { max-width: 44ch; opacity: .9; }
  .cta-band__actions { display: flex; flex-wrap: wrap; gap: var(--gw-space-3); }
</style>
