---
import Photo from '../_shared/Photo.astro';
const { variant = 'services', heading, intro, columns = 3, cards = [], leadSlug } = Astro.props;
---
<section class={`cards cards--${variant}`} style={`--cols:${columns}`}>
  {heading && <h2>{heading}</h2>}
  {intro && <p class="cards__intro">{intro}</p>}
  <ul class="cards__grid">
    {cards.map((c: any) => (
      <li class="card">
        {(c.image || variant === 'team') && <Photo image={c.image} leadSlug={leadSlug} ratio={variant === 'team' ? '3x4' : '4x3'} sizes="(min-width: 900px) 30vw, 100vw" widths={[400, 800]} />}
        <h3>{c.href ? <a href={c.href}>{c.title}</a> : c.title}</h3>
        {c.text && <p>{c.text}</p>}
      </li>
    ))}
  </ul>
</section>
