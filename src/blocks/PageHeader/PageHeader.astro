---
const { eyebrow, heading, intro } = Astro.props;
---
<section class="page-header">
  <div class="inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{heading}</h1>
    {intro && <p>{intro}</p>}
  </div>
</section>
<style>
  .page-header { padding: var(--gw-section-y) var(--gw-gutter); background: var(--gw-color-surface-2); border-bottom: var(--gw-rule) solid var(--gw-color-border); }
  .inner { max-width: var(--gw-max); margin: 0 auto; display: flex; flex-direction: column; gap: var(--gw-space-4); }
  h1 { max-width: 26ch; }
  p { max-width: 52ch; color: var(--gw-color-muted); }
</style>
