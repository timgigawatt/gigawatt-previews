---
const { heading, items = [] } = Astro.props;
---
<section class="testimonials" aria-label={heading}>
  <div class="container">
    <h2>{heading}</h2>
    <div class="track" tabindex="0" role="region" aria-label={`${heading} — scroll`}>
      {items.map((t: any) => (
        <figure>
          <div class="dots" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
          <blockquote>{t.text}</blockquote>
          <figcaption><strong>{t.who}</strong>{t.meta && <> · {t.meta}</>}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .testimonials { padding: var(--gw-section-y) var(--gw-gutter); background: var(--gw-color-bg); }
  h2 { margin-bottom: var(--gw-space-5); }
  .track { display: flex; gap: var(--gw-space-4); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: var(--gw-space-3); scrollbar-width: thin; }
  .track:focus-visible { outline: 2px solid var(--gw-color-primary); outline-offset: 4px; border-radius: var(--gw-radius-sm, 6px); }
  figure { margin: 0; scroll-snap-align: start; flex: 0 0 min(86%, 360px); display: flex; flex-direction: column; gap: var(--gw-space-4); padding: var(--gw-space-5); background: var(--gw-color-surface); border: var(--gw-rule) solid var(--gw-color-border); border-radius: var(--gw-radius-lg); box-shadow: var(--gw-shadow-1); }
  .dots { display: flex; gap: 4px; } .dots span { width: 10px; height: 10px; background: var(--gw-color-accent); border-radius: var(--gw-radius-pill); }
  blockquote { margin: 0; line-height: var(--gw-lh-body); text-wrap: pretty; }
  figcaption { margin-top: auto; font-size: var(--gw-small); color: var(--gw-color-muted); }
  figcaption strong { color: var(--gw-color-text); font-weight: 700; }
</style>
