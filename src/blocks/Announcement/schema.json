{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-block": "Announcement",
  "x-version": 1,
  "x-description": "Site-wide notice rendered by the layout from globals/announcements.json, not placed on a page. Shown while starts <= today <= ends. Only one may be active at a time.",
  "type": "object",
  "required": ["title", "body", "starts", "ends"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "body": { "type": "string", "maxLength": 400 },
    "cta": {
      "type": "object", "required": ["label", "href"], "additionalProperties": false,
      "properties": { "label": { "type": "string", "maxLength": 40 }, "href": { "type": "string" } }
    },
    "starts": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "ends": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "placement": { "type": "string", "enum": ["home-only", "all-pages"], "default": "home-only" },
    "style": { "type": "string", "enum": ["popup", "banner"], "default": "banner" }
  }
}
