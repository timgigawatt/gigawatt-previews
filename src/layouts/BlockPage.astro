---
// Renders one of a lead's pages: its blocks, in order, through the block registry. Each block
// also receives the personality's variant flags so a block whose content sets no `variant`
// falls back to the personality's default (the "four variant flags").
import Base from './Base.astro';
import { blocks } from '../blocks';
import { getPersonality } from '../lib/design';

const { lead, page } = Astro.props;
const flags = getPersonality(lead.settings.personality).flags;
---
<Base lead={lead} title={page.title === 'Home' ? undefined : page.title} description={page.description}>
  {page.blocks.map((b: any) => {
    const Component = (blocks as any)[b.block];
    if (!Component) throw new Error(`Unknown block "${b.block}" in lead "${lead.slug}" page "${page.title}"`);
    const { block, ...props } = b;
    return <Component {...props} leadSlug={lead.slug} flags={flags} />;
  })}
</Base>
