---
// Renders one of a lead's pages: its blocks, in order, through the block registry. Each block
// also receives the personality's variant defaults and flags, so a block whose content sets no
// `variant` falls back to the personality's default and the flags drive its moves.
import Base from './Base.astro';
import { blocks } from '../blocks';
import { getPersonality } from '../lib/design';

const { lead, page, isHome = false, title } = Astro.props;
const persona = getPersonality(lead.settings.personality);
---
<Base lead={lead} title={title ?? (isHome ? undefined : page.title)} description={page.description} isHome={isHome}>
  {page.blocks.map((b: any) => {
    const Component = (blocks as any)[b.block];
    if (!Component) throw new Error(`Unknown block "${b.block}" in lead "${lead.slug}" page "${page.title}"`);
    const { block, ...props } = b;
    return <Component {...props} lead={lead} leadSlug={lead.slug} flags={persona.flags} variants={persona.variants} />;
  })}
</Base>
