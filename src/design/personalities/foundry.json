{
  "name": "foundry",
  "for": "Trades and contractors — plumbing, HVAC, roofing, electrical, concrete.",
  "voice": "Blunt, industrial, trustworthy. Charcoal base, one safety accent, thick rules, sharp corners. Zero whimsy.",
  "move": "Oversized numerals: years in business and jobs done, set at display scale under a thick rule.",
  "fonts": {
    "display": "\"Archivo Black\", Impact, \"Haettenschweiler\", \"Arial Narrow Bold\", sans-serif",
    "body": "\"Archivo\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif",
    "files": [
      {
        "family": "Archivo Black",
        "file": "archivo-black-400.woff2",
        "weight": "400"
      },
      {
        "family": "Archivo",
        "file": "archivo-400-700.woff2",
        "weight": "400 700"
      }
    ]
  },
  "colors": {
    "light": {
      "bg": "#14181b",
      "surface": "#1e242a",
      "surface-2": "#2a3238",
      "text": "#f2f4f5",
      "muted": "#aab4bb",
      "border": "#3a444c",
      "primary": "#ff6a00",
      "primary-hover": "#ff8330",
      "on-primary": "#14181b",
      "accent": "#ffc400",
      "accent-ink": "#ffc400",
      "on-accent": "#14181b",
      "success": "#6ddf8f",
      "warn": "#ffc400",
      "error": "#ff7a6b",
      "focus": "#ffc400",
      "photo-tint": "rgba(255, 106, 0, 0.12)"
    },
    "dark": {
      "bg": "#0c0f11",
      "surface": "#161b1f",
      "surface-2": "#212830",
      "border": "#2f383f"
    }
  },
  "tokens": {
    "--gw-weight-display": "400",
    "--gw-display-tracking": "-0.03em",
    "--gw-display-transform": "uppercase",
    "--gw-display": "clamp(2.6rem, 9.5cqi, 5.75rem)",
    "--gw-lh-display": "0.88",
    "--gw-radius-sm": "0px",
    "--gw-radius-md": "0px",
    "--gw-radius-lg": "0px",
    "--gw-radius-pill": "0px",
    "--gw-radius-photo": "0px",
    "--gw-rule": "2px",
    "--gw-rule-strong": "6px",
    "--gw-shadow-1": "4px 4px 0 var(--gw-color-border)",
    "--gw-shadow-2": "8px 8px 0 var(--gw-color-border)",
    "--gw-shadow-3": "12px 12px 0 var(--gw-color-accent)",
    "--gw-dur-base": "140ms",
    "--gw-ease-standard": "cubic-bezier(0.3, 0, 0.1, 1)"
  },
  "variants": {
    "services": "list",
    "stats": "numerals",
    "gallery": "before-after"
  },
  "flags": {
    "popup": true,
    "numerals": true,
    "beforeAfter": true
  },
  "composition": [
    "Hero",
    "ProofRow",
    "Services:list",
    "Stats:numerals",
    "Gallery:before-after",
    "Testimonials",
    "CtaBand"
  ]
}
